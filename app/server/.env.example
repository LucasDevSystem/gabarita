# Copie pra ".env" e preencha localmente se quiser testar o backend DynamoDB
# fora do Render. Em produção (Render), essas variáveis são configuradas
# direto no painel do serviço — nunca ficam num arquivo commitado.

# "sqlite" (padrão, dev local) ou "dynamodb" (produção)
DB_DRIVER=sqlite

# Porta em que a API escuta
API_PORT=4477

# Só usadas quando DB_DRIVER=dynamodb
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMO_TABLE_PREFIX=gabarita-

# Segredo do painel /admin — acessível em /admin?u=<ADMIN_TOKEN>. Gere algo
# como `openssl rand -hex 32`. Sem isso, o /admin fica inacessível (nenhum
# token bate com uma string vazia).
ADMIN_TOKEN=
